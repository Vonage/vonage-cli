{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@vonage/cli",
  "version": "3.2.4",
  "description": "Vonage CLI",
  "license": "Apache 2.0",
  "contributors": [
    {
      "name": "Paul Ardeleanu",
      "url": "https://github.com/pardel"
    },
    {
      "name": "Chuck \"MANCHUCK\" Reeves",
      "url": "https://github.com/manchuck"
    },
    {
      "name": "Chris Tankersley",
      "url": "https://github.com/dragonmantank"
    }
  ],
  "type": "module",
  "bin": {
    "vonage": "bin/vonage.js"
  },
  "files": [
    "src/**",
    "bin/**",
    "data/**"
  ],
  "scripts": {
    "eslint": "eslint",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "test": "node --test --import ./__tests__/setup.js --experimental-test-module-mocks",
    "test:coverage": "node --test --import ./__tests__/setup.js --experimental-test-module-mocks --experimental-test-coverage --test-reporter=junit --test-reporter-destination=\"./junit.xml\" --test-reporter=spec --test-reporter-destination=stdout --test-coverage-include=\"src/**/*.js\"",
    "test:watch": "node --test --watch --import ./__tests__/setup.js --experimental-test-module-mocks"
  },
  "lint-staged": {
    "package.json": [
      "npx sort-package-json"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@laboralphy/did-you-mean": "3.1.0",
    "@ngrok/ngrok": "1.7.0",
    "@vonage/auth": "1.18.1",
    "@vonage/conversations": "1.17.1",
    "@vonage/jwt": "1.17.1",
    "@vonage/messages": "1.27.1",
    "@vonage/server-client": "1.23.1",
    "@vonage/server-sdk": "3.30.1",
    "ajv": "8.20.0",
    "camelcase": "10.0.0",
    "chalk": "6.0.1",
    "compare-versions": "6.1.1",
    "deepmerge": "4.3.1",
    "dotenv": "18.0.7",
    "json-diff": "1.0.6",
    "jsonwebtoken": "9.0.3",
    "node-fetch": "3.3.2",
    "snakecase": "1.0.0",
    "table": "6.9.0",
    "winston": "3.19.0",
    "yaml": "2.9.1",
    "yargs": "18.2.0",
    "yargs-parser": "22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-plugin-n": "18.4.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "winston-transport": "4.9.0"
  },
  "peerDependencies": {
    "@stoplight/prism-cli": "5.16.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
